# ─────────────────────────────────────────────────────────────────────────────
# Delhi AQI Sentinel - Environment Variables Example
# Copy this file to backend/.env and replace placeholders with your actual keys
# ─────────────────────────────────────────────────────────────────────────────

# World Air Quality Index (WAQI) Token
# Obtain a free token at: https://aqicn.org/data-platform/token/
WAQI_TOKEN=PASTE_YOUR_WAQI_TOKEN_HERE

# OpenRouteService API Key
# Obtain a free key at: https://openrouteservice.org/dev/#/signup
ORS_KEY=PASTE_YOUR_OPENROUTESERVICE_KEY_HERE

# OpenAQ API Key (v3)
# Obtain a free key at: https://explore.openaq.org/register
OPENAQ_KEY=PASTE_YOUR_OPENAQ_KEY_HERE

# Allowed CORS Origins (comma-separated, no trailing slashes)
# Default for local development: http://127.0.0.1:5500,http://localhost:5500
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

